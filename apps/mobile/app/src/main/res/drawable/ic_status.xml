        android:fillColor="#FFFFFFFF"
        android:pathData="M12,2L4,5.5v5.7c0,4.9 3.4,9.4 8,10.8c4.6,-1.4 8,-5.9 8,-10.8V5.5L12,2z" />
</vector>

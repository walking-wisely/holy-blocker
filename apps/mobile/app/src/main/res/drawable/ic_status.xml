<!--
  The notification small icon.

  A flat silhouette on transparency, deliberately: the system masks a small icon
  to its alpha channel and tints it, so anything with colour or interior detail
  renders as a white blob. 24dp is the documented size for this slot.
  https://developer.android.com/develop/ui/views/notifications#notification-anatomy
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="#FFFFFFFF">
